# Copy this file to .env in apps/api, then fill in your Supabase connection.
# Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Replace YOUR_PASSWORD with the database password, URL-encoded if necessary.
# Use a development project: Prisma migrations will create application tables.
# Development: encrypt traffic without verifying the server certificate.
# Deployment: use sslmode=verify-full with the Supabase root certificate.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&uselibpqcompat=true"
